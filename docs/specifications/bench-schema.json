{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kyyzen0/selyth-core/docs/specifications/bench-schema.json",
  "title": "Benchmark report of the verification gate",
  "description": "What tools/bench.py emits after one full pipeline run (lower -> Dafny backend -> policy engine) on an example module: the per-obligation cost the verification report records, plus totals. A measurement, not a verdict: the decision is copied for context only. Validated by tools/test-bench.py. resource_units are deterministic for a fixed tool build and input; wall_ms/cpu_ms are recorded for humans and are explicitly not soundness inputs (see report-schema.json cost).",
  "type": "object",
  "additionalProperties": false,
  "required": ["selyth_bench_version", "produced_at", "report_id", "decision", "policy_digest", "obligation_set_digest", "toolchain", "obligations", "totals"],
  "properties": {
    "selyth_bench_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "produced_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "report_id": {"type": "string", "pattern": "^rpt-[0-9a-f]{16}$"},
    "decision": {"type": "string", "enum": ["accepted", "rejected", "needs-human"]},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "obligation_set_digest": {"$ref": "#/$defs/digest"},
    "toolchain": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object", "additionalProperties": false,
                "required": ["name", "version"],
                "properties": {"name": {"type": "string", "minLength": 1},
                               "version": {"type": "string", "minLength": 1}}}
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["obligation_id", "outcome"],
        "properties": {
          "obligation_id": {"type": "string", "minLength": 1},
          "outcome": {"type": "string", "minLength": 1},
          "resource_units": {"type": "integer", "minimum": 0},
          "wall_ms": {"type": "integer", "minimum": 0},
          "cpu_ms": {"type": "integer", "minimum": 0},
          "peak_rss_bytes": {"type": "integer", "minimum": 0},
          "timed_out": {"type": "boolean"}
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "obligations": {"type": "integer", "minimum": 1},
        "resource_units": {"type": "integer", "minimum": 0},
        "wall_ms": {"type": "integer", "minimum": 0},
        "cpu_ms": {"type": "integer", "minimum": 0},
        "peak_rss_bytes": {"type": "integer", "minimum": 0},
        "timed_out": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
