*.py[cod]
.venv/
venv/
.pytest_cache/

# Verification output. Reports are evidence about a specific artefact at a
# specific hash; committing them would bind a historical result to whatever
# the file happens to be later. Content addressing is the whole point.
.selyth/
*.report.json
reports/

# Solver and backend artefacts
.dfy/
*.boogie
*.bpl
/z3-cache/

# Editor and OS
.DS_Store
*.swp
.idea/
.vscode/